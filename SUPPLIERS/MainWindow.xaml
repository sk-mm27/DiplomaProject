<Window x:Class="SUPPLIERS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SUPPLIERS"
        mc:Ignorable="d"
        Title="Авторизация" Height="173.167" Width="330" Style="{StaticResource WinFont}" WindowStartupLocation="CenterScreen">
    <Border Padding="5">
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Title}">Авторизация</TextBlock>
            <Separator Background="#BF5324"></Separator>
            <DockPanel Margin="5">
                <TextBlock Width="50" Margin="5" Style="{StaticResource label}">Логин</TextBlock>
                <TextBox x:Name="LOGIN"></TextBox>
            </DockPanel>
            <DockPanel Margin="5">
                <TextBlock Width="50" Margin="5" Style="{StaticResource label}">Пароль</TextBlock>
                <PasswordBox x:Name="PASSWORD"></PasswordBox>
            </DockPanel>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource ButtonText}" Margin="5" Click="Registration">Заявка на регистрацию</Button>
                <Button Grid.Column="2" Margin="5" Width="100" Click="Login" Style="{StaticResource Button}">Войти</Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
