<Window x:Class="SUPPLIERS.Windows.MessageWinСontacts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SUPPLIERS.Windows"
        mc:Ignorable="d"
        Title="Контактные данные" Height="140" Width="570" Style="{StaticResource WinFont}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Line">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="X2" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Line Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Stroke="Black" Stretch="Fill" X2="1" VerticalAlignment="Center"/>
        <Line Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Stroke="Black" Stretch="Fill" X2="1" VerticalAlignment="Center"/>
        <Line Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Stroke="Black" Stretch="Fill" X2="1" VerticalAlignment="Center"/>
        <StackPanel  Grid.Row="0" Grid.Column="1" Grid.RowSpan="7" Orientation="Horizontal" HorizontalAlignment="Center">
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="Black"/>
        </StackPanel>
        <StackPanel  Grid.Row="0" Grid.Column="3" Grid.RowSpan="7" Orientation="Horizontal" HorizontalAlignment="Center">
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="Black"/>
        </StackPanel>

        <TextBlock Style="{StaticResource label}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2" Text="Телефоны" HorizontalAlignment="Center" />
        <TextBlock Style="{StaticResource label}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="4" Text="Email" HorizontalAlignment="Center"/>

        <TextBlock Style="{StaticResource label}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Text="Организация"/>
        <TextBlock Style="{StaticResource label}" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Text="Менеджер"/>
        <TextBlock Style="{StaticResource label}" VerticalAlignment="Center" Grid.Row="6" Grid.Column="0" Text="Дополнительный"/>

        <TextBox x:Name="Phone_0" Grid.Row="2" Grid.Column="2"/>
        <TextBox x:Name="Phone_1" Grid.Row="4" Grid.Column="2"/>
        <TextBox x:Name="Phone_2" Grid.Row="6" Grid.Column="2"/>

        <TextBox x:Name="Email_0" Grid.Row="2" Grid.Column="4"/>
        <TextBox x:Name="Email_1" Grid.Row="4" Grid.Column="4"/>
        <TextBox x:Name="Email_2" Grid.Row="6" Grid.Column="4"/>
    </Grid>
</Window>
