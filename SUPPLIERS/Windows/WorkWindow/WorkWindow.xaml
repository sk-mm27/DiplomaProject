,6.9512197 0.97289639,6.8412494"></Path>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Название" Binding="{Binding NAME}"/>
                                        <DataGridTextColumn Header="Часовой пояс" Binding="{Binding TIME_ZONE.IN_MOSCOW}"/>
                                        <DataGridTemplateColumn Header="ИНН">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Height="30" Content="{Binding INN}" Click="OpenRegistry" Style="{StaticResource ButtonText}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Вид собственности" Binding="{Binding FORM_OWNERSHIP, Converter={StaticResource DFO}}"/>
                                        <DataGridTextColumn Header="Вид деятельности" Binding="{Binding TYPE_ACTIVITY.NAME}"/>
                                        <DataGridTextColumn Header="Профиль" Binding="{Binding PROFILE.NAME}"/>
                                        <DataGridTemplateColumn Header="Адрес">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Height="30" VerticalAlignment="Center" Click="OpenMap" Content="{Binding ADDRESS, Converter={StaticResource Address}}" Style="{StaticResource ButtonText}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Контакты">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Height="30" Click="OpenСontacts" Content="Контакты" Style="{StaticResource ButtonText}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Часы работы">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Click="OpenOpeningHours" Content="Часы" Style="{StaticResource ButtonText}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Договоры&#x0a;на поставку">
                        <Border Background="White">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="6*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Button}" x:Name="Del_DeliveryContract" Grid.Column="0" Click="DeleteDeliveryContract">Удалить</Button>
                                    <TextBox x:Name="Search_DeliveryContract" Grid.Column="2" TextChanged="SearchNameDeliveryContract" />
                                    <DockPanel x:Name="Search_Tag_DeliveryContract" Grid.Column="2" Visibility="Hidden">
                                        <Button x:Name="Clear_SearchTag_DeliveryContract" Click="Clear_SearchTag" Width="20" Style="{StaticResource Button}">X</Button>
                                        <ComboBox x:Name="SearchTag_DeliveryContract" DisplayMemberPath="NAME" SelectedValuePath="TAG_ID" SelectionChanged="SearchTagDeliveryContract"/>
                                    </DockPanel>
                                    <Path x:Name="DeliveryContract" Grid.Column="3" HorizontalAlignment="Center" MouseDown="Toggle_SearchTag" Stroke="#BF5324" Data="M15 15L21 21M10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10C17 13.866 13.866 17 10 17Z" Fill="White"/>
                                    <Button Style="{StaticResource Button}" x:Name="New_DeliveryContract" Grid.Column="5" Click="NewDeliveryContract">Создать</Button>
                                </Grid>
                                <DataGrid x:Name="DataGrid_DeliveryContract" ColumnWidth="*" MouseDoubleClick="ChangeDeliveryContract">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Номер" Binding="{Binding NUMBER}"/>
                                        <DataGridTextColumn Header="Поставщик" Binding="{Binding SUPPLIER.NAME}"/>
                                        <DataGridTextColumn Header="Дата оформления" Binding="{Binding DATE, StringFormat=dd.MM.yyyy}"/>
                                        <DataGridTextColumn Header="Крайняя дата" Binding="{Binding DATE_FINISH, StringFormat=dd.MM.yyyy}"/>
                                        <DataGridTextColumn Header="Комментарий" Binding="{Binding COMMENT}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Приходные&#x0a;накладные">
                        <Border Background="White">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="6*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Button}" x:Name="Del_PurchaseInvoice" Grid.Column="0" Click="DeletePurchaseInvoice">Удалить</Button>
                                    <TextBox x:Name="Search_PurchaseInvoice" Grid.Column="2" TextChanged="SearchNamePurchaseInvoice"/>
                                    <DockPanel x:Name="Search_Tag_PurchaseInvoice" Grid.Column="2" Visibility="Hidden">
                                        <Button x:Name="Clear_SearchTag_PurchaseInvoice" Click="Clear_SearchTag" Width="20" Style="{StaticResource Button}">X</Button>
                                        <ComboBox x:Name="SearchTag_PurchaseInvoice" DisplayMemberPath="NAME" SelectedValuePath="TAG_ID" SelectionChanged="SearchTagPurchaseInvoice"/>
                                    </DockPanel>
                                    <Path x:Name="PurchaseInvoice" Grid.Column="3" HorizontalAlignment="Center" MouseDown="Toggle_SearchTag" Stroke="#BF5324" Data="M15 15L21 21M10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10C17 13.866 13.866 17 10 17Z" Fill="White"/>
                                    <Button Style="{StaticResource Button}" x:Name="New_PurchaseInvoice" Grid.Column="5" Click="NewPurchaseInvoice">Создать</Button>
                                </Grid>
                                <DataGrid x:Name="DataGrid_PurchaseInvoice" ColumnWidth="*" MouseDoubleClick="ChangePurchaseInvoice">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Номер" Binding="{Binding NUMBER}"/>
                                        <DataGridTextColumn Header="Договор" Binding="{Binding DELIVERY_CONTRACT.NUMBER}"/>
                                        <DataGridTextColumn Header="Поставщик" Binding="{Binding DELIVERY_CONTRACT.SUPPLIER.NAME}"/>
                                        <DataGridTextColumn Header="Дата оформления" Binding="{Binding DATE, StringFormat=dd.MM.yyyy}"/>
                                        <DataGridTextColumn Header="Качество" Binding="{Binding QUALITY.NAME}"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding STATUS.NAME}"/>
                                        <DataGridTextColumn Header="Комментарий" Binding="{Binding COMMENT}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PurchaseInvoice_ID" Visibility="Hidden"/>
                            </DockPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Рейтинг">
                <DataGrid x:Name="DataGrid_RSupplier" ColumnWidth="*">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Рейтинг" Binding="{Binding RATING}" Width="60"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding NAME}"/>
                        <DataGridTextColumn Header="ИНН" Binding="{Binding INN}"/>
                        <DataGridTextColumn Header="Вид деятельности" Binding="{Binding TYPE_ACTIVITY}"/>
                        <DataGridTextColumn Header="Профиль" Binding="{Binding PROFILE}"/>
                        <DataGridTextColumn Header="Доставки в срок" Binding="{Binding DeliveryOnTime}"/>
                        <DataGridTextColumn Header="Доставки не в срок" Binding="{Binding DeliveryNotOnTime}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Пользователи" x:Name="Users">
                <Border>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button}" x:Name="NotAct_User" Grid.Column="1" Click="NotAct">Деактивировать</Button>
                            <Button Style="{StaticResource Button}" x:Name="Act_User" Grid.Column="3" Click="Act">Активировать</Button>
                        </Grid>
                        <DataGrid x:Name="DataGrid_User" ColumnWidth="*">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding LOGIN}"/>
                                <DataGridTextColumn Header="Пароль" Binding="{Binding PASSWORD}"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding ROLE.NAME}"/>
                                <DataGridTextColumn Header="Последняя активность" Binding="{Binding LAST_ACTIVITY, StringFormat=dd.MM.yyyy}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding STATUS}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
