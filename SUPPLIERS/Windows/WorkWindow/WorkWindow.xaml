<Window x:Class="SUPPLIERS.Windows.WorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SUPPLIERS.Windows"
        xmlns:c="clr-namespace:SUPPLIERS.Controller"
        mc:Ignorable="d"
        Title="Учёт поставщиков" Height="450" Width="852.5" Style="{StaticResource WinFont}" Closed="Window_Closed" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="ColumnWidth" Value="*"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="Padding" Value="5"/>
        </Style>
        <c:DecipheringFormOwnership x:Key="DFO"/>
        <c:GetAddress x:Key="Address"/>
    </Window.Resources>    
    <Grid>
        <TabControl>
            <TabItem Header="Поставки">
                <TabControl TabStripPlacement="Left" Background="#BF5324">
                    <TabItem Header="Поставщики">
                        <Border Background="White">
                            <DockPanel Background="White">
                                <Grid DockPanel.Dock="Top" Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="6*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Button}" x:Name="Del_Supplier" Grid.Column="0" Click="DeleteSupplier">Удалить</Button>
                                    <TextBox x:Name="Search_Supplier" Grid.Column="2" TextChanged="SearcNamehSupplier"/>
                                    <DockPanel x:Name="Search_Tag_Supplier" Grid.Column="2" Visibility="Hidden">
                                        <Button x:Name="Clear_SearchTag_Supplier" Click="Clear_SearchTag" Width="20" Style="{StaticResource Button}">X</Button>
                                        <ComboBox x:Name="SearchTag_Supplier" DisplayMemberPath="NAME" SelectedValuePath="TAG_ID" SelectionChanged="SearcTaghSupplier"/>
                                    </DockPanel>
                                    <Path x:Name="Supplier" Grid.Column="3" HorizontalAlignment="Center" MouseDown="Toggle_SearchTag" Stroke="#BF5324" Data="M15 15L21 21M10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10C17 13.866 13.866 17 10 17Z" Fill="White" Cursor="Help"/>
                                    <Button Style="{StaticResource Button}" x:Name="New_Supplier" Grid.Column="5" Click="NewSupplier">Создать</Button>
                                </Grid>
                                <DataGrid x:Name="DataGrid_Supplier" DockPanel.Dock="Bottom" FrozenColumnCount="3" MouseDoubleClick="ChangeSupplier">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="35">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Height="30" Click="OpenNowTime" BorderBrush="{x:Null}" Background="{x:Null}">
                                                        <Path HorizontalAlignment="Center" Fill="#BF5324" Data="M 20.410333,23.579688 18.92599,22.15937 18.637065,22.338975 c -1.541732,0.958391 -3.273555,1.537384 -5.098951,1.704712 -0.230843,0.02116 -0.689202,0.03775 -1.043187,0.03775 -1.268766,0 -2.387579,-0.173081 -3.5707918,-0.552401 C 8.0293055,23.242162 7.2632089,22.889902 6.4188162,22.37706 L 6.0625894,22.160705 4.592098,23.567597 c -1.1803727,1.129322 -1.4840198,1.406892 -1.5390627,1.406892 -0.093516,0 -0.4215861,-0.109081 -0.5905366,-0.196349 C 2.0959938,24.588829 1.8094006,24.206874 1.7834948,23.873202 L 1.7709379,23.711452 3.1841833,22.361268 4.5974286,21.011084 4.3080124,20.715491 C 3.167856,19.551001 2.3549043,18.26643 1.8330912,16.80479 0.68497585,13.588821 1.1674837,10.066214 3.1378573,7.2792 5.0619593,4.5576354 8.0894986,2.8483951 11.521614,2.5460317 c 0.407448,-0.035895 1.533383,-0.036572 1.933294,-0.00117 2.455043,0.2173821 4.666236,1.1209687 6.479867,2.6479458 1.789526,1.5066806 3.026772,3.4940734 3.557596,5.7145715 0.453123,1.895472 0.345445,3.971432 -0.301131,5.805592 -0.197285,0.559645 -0.337631,0.881276 -0.621041,1.423245 -0.508531,0.972469 -1.139256,1.831142 -1.922434,2.617206 l -0.25604,0.256984 1.411492,1.350429 1.411492,1.350428 v 0.166962 C 23.214709,24.559268 22.761058,25 22.060057,25 H 21.894676 Z M 13.46824,21.338541 c 0.944481,-0.105176 1.852008,-0.360262 2.715345,-0.763225 0.764184,-0.356683 1.552036,-0.867964 2.043093,-1.325878 0.640792,-0.597542 0.975199,-0.975242 1.358369,-1.534228 0.697575,-1.017654 1.117834,-2.123459 1.313984,-3.457406 0.05466,-0.37175 0.04688,-1.612341 -0.01256,-2.003 C 20.708243,11.083543 20.356696,10.114744 19.763725,9.1607327 19.1659,8.198911 18.322121,7.3280623 17.348161,6.6676743 15.103016,5.1453679 12.143317,4.7841435 9.5349881,5.7140953 6.8067682,6.6867903 4.7725038,8.9724238 4.2018723,11.706212 c -0.125385,0.600697 -0.1469198,0.843116 -0.1450654,1.633018 0.00145,0.618954 0.010559,0.782279 0.061169,1.09718