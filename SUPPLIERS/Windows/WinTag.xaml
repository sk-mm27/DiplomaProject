<Window x:Class="SUPPLIERS.Windows.WinTag"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:SUPPLIERS.Windows"
        mc:Ignorable="d"
        Title="Тег" Height="226.667" Width="400" Style="{StaticResource WinFont}" WindowStartupLocation="CenterScreen">    
    <Border Padding="5">
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Title}">Тег</TextBlock>
            <Separator Background="#BF5324"></Separator>
            <DockPanel Margin="5">
                <TextBlock Width="70" Style="{StaticResource label}">Название</TextBlock>
                <TextBox x:Name="NAME"></TextBox>
            </DockPanel>
            <DockPanel Margin="5">
                <TextBlock Width="70" Style="{StaticResource label}">Цвет</TextBlock>
                <xctk:ColorPicker x:Name="COLOR"/>
            </DockPanel>
            <DockPanel Margin="5">
                <TextBlock Width="70" Style="{StaticResource label}">Описание</TextBlock>
                <TextBox Height="60" x:Name="DESCRIPTION"></TextBox>
            </DockPanel>
            <Grid Margin="20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Button Width="100" Grid.Column="0" Click="ButtonClose" Style="{StaticResource Button}">Отмена</Button>
                <Button Width="100" Grid.Column="2" Click="Save" Style="{StaticResource Button}">Сохранить</Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
