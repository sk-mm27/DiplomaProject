<Window x:Class="SUPPLIERS.Windows.WinSupplier"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SUPPLIERS.Windows" 
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Поставщик" Height="427" Width="728.5" Style="{StaticResource WinFont}" WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <Border Padding="5" MaxWidth="700">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Title}">Поставщик</TextBlock>
                <Separator Background="#BF5324"></Separator>
                <Border>
                    <StackPanel>
                        <DockPanel Margin="5">
                            <TextBlock Width="120" Style="{StaticResource label}">Название</TextBlock>
                            <TextBox x:Name="NAME"></TextBox>
                        </DockPanel>

                        <DockPanel Margin="5">
                            <TextBlock Width="120" Style="{StaticResource label}">Часовой пояс</TextBlock>
                            <ComboBox x:Name="TIME_ZONE" SelectedValuePath="TIME_ZONE_ID">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}По москве: {0}; UTC: {1}">
                                                    <Binding Path="IN_MOSCOW"/>
                                                    <Binding Path="GLOBAL"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <DockPanel Margin="5" LastChildFill="True">
                            <TextBlock Width="120" Style="{StaticResource label}">Вид собственности</TextBlock>
                            <ComboBox x:Name="FORM_OWNERSHIP" SelectionChanged="FormOwnership_SelectionChanged">
                                <ComboBoxItem Content="Юридическое лицо"/>
                                <ComboBoxItem Content="Физическое лицо"/>
                            </ComboBox>
                        </DockPanel>

                        <DockPanel Margin="5" LastChildFill="True">
                            <TextBlock Width="120" Style="{StaticResource label}">ИНН</TextBlock>
                            <xctk:MaskedTextBox x:Name="INN" IsEnabled="False"></xctk:MaskedTextBox>
                        </DockPanel>



                        <Grid  Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="auto" Grid.Column="0" Style="{StaticResource label}">Вид деятельности</TextBlock>
                            <ComboBox x:Name="TYPE_ACTIVITY" Width="auto" Grid.Column="1" DisplayMemberPath="NAME" SelectedValuePath="TYPE_ACTIVITY_ID"></ComboBox>
                            <Button x:Name="New_TypeActivity" Width="auto" Grid.Column="2" Click="NewTypeActivity" Style="{StaticResource Button}">+</Button>
                        </Grid>

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="auto" Grid.Column="0" Style="{StaticResource label}">Профиль</TextBlock>
                            <ComboBox x:Name="PROFILE"  Width="auto" Grid.Column="1" DisplayMemberPath="NAME" SelectedValuePath="PROFILE_ID"></ComboBox>
                            <Button x:Name="New_Profile" Width="auto" Grid.Column="2" Click="NewProfile" Style="{StaticResource Button}">+</Button>
                        </Grid>

                        <DockPanel HorizontalAlignment="Stretch" Margin="5">
                            <TextBlock Width="120" VerticalAlignment="Center" Style="{StaticResource label}">Адрес</TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*"/>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="1.7*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource label}" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center">Индекс</TextBlock>
                                <TextBox x:Name="ADDRESS_0" Grid.Column="0" Grid.Row="1"></TextBox>

                                <TextBlock Style="{StaticResource label}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center">Город</TextBlock>
                                <TextBox x:Name="ADDRESS_1" Grid.Column="1" Grid.Row="1"></TextBox>

                                <TextBlock Style="{StaticResource label}" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center">Улица</TextBlock>
                                <TextBox x:Name="ADDRESS_2" Grid.Column="2" Grid.Row="1"></TextBox>

                                <TextBlock Style="{StaticResource label}" Grid.Column="3" Grid.Row="0" HorizontalAlignment="Center">Строение</TextBlock>
                                <TextBox x:Name="ADDRESS_3" Grid.Column="3" Grid.Row="1"></TextBox>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Expander Margin="0,5" Header="Контактные данные">
                    <Border Margin="5,0" BorderBrush="Black" BorderThickness="1" Padding="5" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="7*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource label}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center">Телефон</TextBlock>
                                <TextBlock Style="{StaticResource label}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center">Формат</TextBlock>
                                <TextBlock Style="{StaticResource label}" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center">Номер</TextBlock>

                                <TextBlock Style="{StaticResource label}" Grid.Column="0" Grid.Row="2">Организация</TextBlock>
                                <ComboBox x:Name="PhoneFormat_Organization" Height="22" Grid.Column="1" Grid.Row="2" SelectedValuePath="PHONE_FORMAT_ID" SelectionChanged="PhoneFormat_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Height="18" Orientation="Horizontal">
                                                <Image Source="{Binding FLAG}"/>
                                                <TextBlock Text="{Binding FORMAT}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <xctk:MaskedTextBox x:Name="Phone_Organization" Grid.Column="2" Grid.Row="2" TextWrapping="Wrap" IsEnabled="False"/>

                                <TextBlock Style="{StaticResource label}" Grid.Column="0" Grid.Row="4">Менеджер</TextBlock>
                                <ComboBox x:Name="PhoneFormat_Manager" Height="22" Grid.Column="1" Grid.Row="4" SelectedValuePath="PHONE_FORMAT_ID" SelectionChanged="PhoneFormat_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Height="18" Orientation="Horizontal">
                                                <Image Source="{Binding FLAG}" />
                                                <TextBlock Text="{Binding FORMAT}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <xctk:MaskedTextBox x:Name="Phone_Manager" Grid.Column="2" Grid.Row="4" TextWrapping="Wrap" IsEnabled="False"/>

                                <TextBlock Style="{StaticResource label}" Grid.Column="0" Grid.Row="6">Дополнительный</TextBlock>
                                <ComboBox x:Name="PhoneFormat_Additional" Height="22" Grid.Column="1" Grid.Row="6" SelectedValuePath="PHONE_FORMAT_ID" SelectionChanged="PhoneFormat_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Height="18" Orientation="Horizontal">
                                                <Image Source="{Binding FLAG}" />
                                                <TextBlock Text="{Binding FORMAT}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <xctk:MaskedTextBox x:Name="Phone_Additional" Grid.Column="2" Grid.Row="6" TextWrapping="Wrap" IsEnabled="False"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource label}" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">Email</TextBlock>


                                <TextBox x:Name="Email_Organization" Grid.Row="2"></TextBox>

                                <TextBox x:Name="Email_Manager" Grid.Row="4"></TextBox>

                                <TextBox x:Name="Email_Additional" Grid.Row="6"></TextBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Expander>

                <Expander Margin="0,5" Header="Рабочее время">
                    <Border Margin="5,0" BorderBrush="Black" BorderThickness="1" Padding="5" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource label}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right">Пн</TextBlock>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <xctk:TimePicker x:Name="OPENING_HOURS_0_0" Width="95"/>
                                <TextBlock>-</TextBlock>
                                <xctk:TimePicker x:Name="OPENING_HOURS_0_1" Width="95"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource label}" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right">Вт</TextBlock>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <xctk:TimePicker  x:Name="OPENING_HOURS_1_0" Width="95"/>
                                <TextBlock>-</TextBlock>
                                <xctk:TimePicker  x:Name="OPENING_HOURS_1_1" Width="95"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource label}" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right">Ср</TextBlock>
                            <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <xctk:TimePicker  x:Name="OPENING_HOURS_2_0" Width="95"/>
                                <TextBlock>-</TextBlock>
                                <xctk:TimePicker  x:Name="OPENING_HOURS_2_1" Width="95"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource label}" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Right">Чт</TextBlock>
                            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                <xctk:TimePicker  x:Name="OPENING_HOURS_3_0" Width="95"/>
                                <TextBlock>-</TextBlock>
                                <xctk:TimePicker  x:Name="OPENING_HOURS_3_1" Width="95"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource label}" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Right">Пт</TextBlock>
                            <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                <xctk:TimePicker  x:Name="OPENING_HOURS_4_0" Width="95"/>
                                <TextBlock>-</TextBlock>
                                <xctk:TimePicker  x:Name="OPENING_HOURS_4_1" Width="95"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource label}" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Right">Сб</TextBlock>
                            <StackPanel Grid.Row="4" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                <xctk:TimePicker  x:Name="OPENING_HOURS_5_0" Width="95"/>
                                <TextBlock>-</TextBlock>
                                <xctk:TimePicker  x:Name="OPENING_HOURS_5_1" Width="95"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource label}" Grid.Row="0" Grid.Column="6" HorizontalAlignment="Right">Вс</TextBlock>
                            <StackPanel Grid.Row="0" Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center">
                                <xctk:TimePicker  x:Name="OPENING_HOURS_6_0" Width="95"/>
                                <TextBlock>-</TextBlock>
                                <xctk:TimePicker  x:Name="OPENING_HOURS_6_1" Width="95"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <Expander Margin="0,5" Header="Теги">
                    <Border Margin="5,10,5,5" BorderBrush="Black" BorderThickness="1" Padding="5" Height="100" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="DataGrid_Tag" Style="{StaticResource GridStyle}" ColumnWidth="*" Grid.Column="0">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Тег">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NAME}" Background="{Binding COLOR}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Width="auto" Grid.Column="0">Тег</TextBlock>
                                    <ComboBox x:Name="TAG" Width="auto" Grid.Column="1" DisplayMemberPath="NAME" SelectedValuePath="TAG_ID"></ComboBox>
                                    <Button x:Name="New_Tag" Width="auto" Grid.Column="2" Click="NewTag">+</Button>
                                </Grid>
                                <Grid Margin="20,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Button}" Width="100" Grid.Column="0" Click="DelTag">Удалить</Button>
                                    <Button Style="{StaticResource Button}" Width="100" Grid.Column="2" Click="AddTag">Добавить</Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <Grid Margin="20,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Width="100" Grid.Column="0" Click="ButtonClose" Style="{StaticResource Button}">Отмена</Button>
                    <Button Width="100" Grid.Column="2" Click="Save" Style="{StaticResource Button}">Сохранить</Button>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
